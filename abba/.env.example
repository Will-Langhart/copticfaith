# Copy to .env and fill in. ANTHROPIC_API_KEY is required.
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith — enables the tracing dashboard and LangGraph Platform.
# Get a key at smith.langchain.com; leave blank to run without tracing.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=abba

# Models (defaults match the current copticfaith app + the fast tier for meta)
SYNTH_MODEL=claude-sonnet-4-5
META_MODEL=claude-haiku-4-5-20251001

# Local embeddings — runs offline via fastembed, no API key needed.
# Swap to Voyage/OpenAI in retrieval.py for production.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Storage + corpus (paths are resolved relative to the abba/ dir)
CHROMA_DIR=.chroma
CORPUS_PATH=../corpus/corpus.jsonl
VERIFIED_QUOTES_PATH=../corpus/verified_quotes.json

# Retrieval
TOP_K=6
