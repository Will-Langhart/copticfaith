# Copy to .env and fill in. Required: ANTHROPIC_API_KEY, PINECONE_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith — enables the tracing dashboard and LangSmith Deployment.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=abba

# Pinecone — integrated inference (embeds server-side). Use the SAME key here
# and on the LangSmith deployment so both point at the same index.
PINECONE_API_KEY=
PINECONE_INDEX=coptic-corpus
PINECONE_NAMESPACE=copticfaith
PINECONE_EMBED_MODEL=multilingual-e5-large

# Models
SYNTH_MODEL=claude-sonnet-4-5
META_MODEL=claude-haiku-4-5-20251001

# Corpus (paths resolve relative to the abba/ dir)
CORPUS_PATH=corpus/corpus.jsonl
VERIFIED_QUOTES_PATH=corpus/verified_quotes.json

# Retrieval
TOP_K=6
# Backfill pass that guarantees quotation chunks reach the meta node.
QUOTE_TOP_K=20
QUOTE_BACKFILL=2
