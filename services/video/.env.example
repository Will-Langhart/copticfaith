# Copy to .env and fill in. .env is gitignored.

# Claude — writes the narration script
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5

# ElevenLabs — narration voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# e.g. eleven_multilingual_v2
ELEVENLABS_MODEL_ID=

# Meta Graph API — only used with --publish
META_PAGE_ID=
META_IG_USER_ID=
META_ACCESS_TOKEN=
# Optional, defaults to v23.0
# META_GRAPH_VERSION=v23.0

# Optional, defaults to https://copticfaith.app
# SITE_URL=https://copticfaith.app
